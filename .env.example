# Environment Configuration Template

# Application Settings
ENVIRONMENT=development
DEBUG=false
APP_NAME="Trading System"
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Trading 212 API
TRADING212__API_KEY=your_api_key_here
TRADING212__ACCOUNT_ID=your_account_id
TRADING212__DEMO_MODE=true
TRADING212__REQUEST_TIMEOUT=30
TRADING212__RATE_LIMIT=100

# Database
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=postgres
DATABASE__PASSWORD=postgres
DATABASE__DB=trading_system

# Redis
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=

# Machine Learning
ML__MODEL_TYPE=xgboost
ML__LOOKBACK_PERIOD=60
ML__PREDICTION_HORIZON=1
ML__FEATURE_SET=standard
ML__N_TRIALS=50

# Backtesting
BACKTEST__START_DATE=2023-01-01
BACKTEST__END_DATE=2024-01-01
BACKTEST__INITIAL_CAPITAL=10000.0
BACKTEST__COMMISSION=0.001
BACKTEST__SLIPPAGE=0.0005
BACKTEST__TIMEFRAME=1d

# Risk Management
RISK__MAX_POSITION_SIZE=0.05
RISK__MIN_POSITION_SIZE=100.0
RISK__MAX_CONCURRENT_POSITIONS=3
RISK__MAX_DAILY_LOSS_PCT=0.02
RISK__STOP_LOSS_ATR_MULTIPLE=2.0
RISK__TAKE_PROFIT_RISK_REWARD=2.0
RISK__VOLATILITY_ADJUSTMENT=true

# Trading
TRADING_ENABLED=false
PAPER_TRADING=true
SYMBOLS=AAPL,MSFT,GOOGL

# Monitoring
ENABLE_PROMETHEUS=true
METRICS_PORT=8001
